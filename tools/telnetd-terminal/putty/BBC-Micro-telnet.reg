Windows Registry Editor Version 5.00

; PuTTY saved sessions for the Pi1MHz's TelnetD: "BBC Micro" (80 x 32 in the BBC Micro MOS font, terminal
; type xterm-bbc: TelnetD draws every MODE in its own shape) and "BBC Micro MODE 7" (40 x 25 in the teletext
; font: MODE 7 exactly). Install the fonts first: ..\windows\install.cmd. Earlier kits' per-MODE sessions go.
; All telnet to host "Pi1MHz" (change Host Name in PuTTY for an IP address), with the BBC's colours, UTF-8 (the
; pound sign and the teletext graphics) and function keys as ESC [ n ~ (F12 is BREAK).
; Double-click to add them; they appear in PuTTY's Saved Sessions list.

[-HKEY_CURRENT_USER\Software\SimonTatham\PuTTY\Sessions\BBC%20Micro%20MODE%200-3]
[-HKEY_CURRENT_USER\Software\SimonTatham\PuTTY\Sessions\BBC%20Micro%20MODE%201-4-6]
[-HKEY_CURRENT_USER\Software\SimonTatham\PuTTY\Sessions\BBC%20Micro%20MODE%202-5]

[HKEY_CURRENT_USER\Software\SimonTatham\PuTTY\Sessions\BBC%20Micro]
"HostName"="Pi1MHz"
"Protocol"="telnet"
"PortNumber"=dword:00000017
"TermWidth"=dword:00000050
"TermHeight"=dword:00000020
"Font"="BBC Micro MOS"
"TerminalType"="xterm-bbc"
"FontHeight"=dword:0000000c
"FontIsBold"=dword:00000000
"FontCharSet"=dword:00000000
"FontQuality"=dword:00000001
"LineCodePage"="UTF-8"
"FunctionKeys"=dword:00000000
"BackspaceIsDelete"=dword:00000001
"LocalEcho"=dword:00000002
"LocalEdit"=dword:00000002
"CurType"=dword:00000001
"BlinkCur"=dword:00000001
"BoldAsColour"=dword:00000001
"WinTitle"="BBC Micro"
"Colour0"="255,255,255"
"Colour1"="255,255,255"
"Colour2"="0,0,0"
"Colour3"="0,0,0"
"Colour4"="0,0,0"
"Colour5"="255,255,255"
